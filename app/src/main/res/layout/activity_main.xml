<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <Button
                android:id="@+id/button_cassa"
                style="@style/KeyStyle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/Cassa_button" />

            <Button
                android:id="@+id/button_rullante"
                style="@style/KeyStyle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/Rullante_button" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <Button
                android:id="@+id/button_Hi_hat_aperto"
                style="@style/KeyStyle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/Hi_hat_aperto_button" />

            <Button
                android:id="@+id/button_Hi_hat_chiuso"
                style="@style/KeyStyle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/Hi_hat_chiuso_button" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <Button
                android:id="@+id/button_Piatti"
                style="@style/KeyStyle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/Piatti_button" />

            <Button
                android:id="@+id/button_Tom_button"
                style="@style/KeyStyle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/Tom_button" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <Button
                android:id="@+id/button_Tom_alto"
                style="@style/KeyStyle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/Tom_alto_button" />

            <Button
                android:id="@+id/buttonTom_basso"
                style="@style/KeyStyle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/Tom_basso_button" />
        </TableRow>
    </TableLayout>
</androidx.constraintlayout.widget.ConstraintLayout>